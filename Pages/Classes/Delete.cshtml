@page "{id:int}"
@model lab9.Pages.Classes.DeleteModel
@{
    ViewData["Title"] = "Delete Class";
}

<h1>Delete Class</h1>

<h3>Are you sure you want to delete this class?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.ClassInfo.Name</dd>
        <dt class="col-sm-2">Person Count</dt>
        <dd class="col-sm-10">@Model.ClassInfo.PersonCount</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.ClassInfo.Description</dd>
        <dt class="col-sm-2">Is Active?</dt>
        <dd class="col-sm-10">
            @(Model.ClassInfo.IsActive ? "Yes" : "No")
        </dd>
    </dl>
</div>

<form method="post">
    <input type="hidden" asp-for="ClassInfo.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>