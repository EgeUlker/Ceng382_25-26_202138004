@page
@model lab8.Pages.CreateModel
@{
    ViewData["Title"] = "Create Class";
}

<h1>Create Class</h1>

<form method="post">
    <div>
        <label asp-for="ClassInformation.ClassName"></label>
        <input asp-for="ClassInformation.ClassName" />
        <span asp-validation-for="ClassInformation.ClassName"></span>
    </div>
    <div>
        <label asp-for="ClassInformation.Instructor"></label>
        <input asp-for="ClassInformation.Instructor" />
        <span asp-validation-for="ClassInformation.Instructor"></span>
    </div>
    <div>
        <label asp-for="ClassInformation.StartDate"></label>
        <input asp-for="ClassInformation.StartDate" type="date" />
        <span asp-validation-for="ClassInformation.StartDate"></span>
    </div>
    <div>
        <label asp-for="ClassInformation.StudentCount"></label>
        <input asp-for="ClassInformation.StudentCount" type="number" />
        <span asp-validation-for="ClassInformation.StudentCount"></span>
    </div>
    <div>
        <label asp-for="ClassInformation.Description"></label>
        <input asp-for="ClassInformation.Description" />
        <span asp-validation-for="ClassInformation.Description"></span>
    </div>
    <div style="margin-top:10px;">
        <button type="submit">Create</button>
        <a asp-page="/Index">Back to List</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}