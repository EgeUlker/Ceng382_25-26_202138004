@page
@model lab5.Pages.IndexModel
@{
    ViewData["Title"] = "Class List";
}

<h1 class="text-center mt-3">@ViewData["Title"]</h1>

<div class="container">
    <div class="row">
        <!-- Sol: Form -->
        <div class="col-md-6">
            <form method="post">
                <div class="mb-3">
                    <label for="className" class="form-label">Class Name:</label>
                    <input type="text" id="className" name="NewClass.ClassName" class="form-control" />
                    <span class="text-danger" asp-validation-for="NewClass.ClassName"></span>
                </div>
                <div class="mb-3">
                    <label for="studentCount" class="form-label">Student Count:</label>
                    <input type="number" id="studentCount" name="NewClass.StudentCount" class="form-control" />
                    <span class="text-danger" asp-validation-for="NewClass.StudentCount"></span>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <textarea id="description" name="NewClass.Description" class="form-control"></textarea>
                    <span class="text-danger" asp-validation-for="NewClass.Description"></span>
                </div>
                <button type="submit" class="btn btn-primary" asp-page-handler="Add">Add</button>
            </form>
        </div>

        <!-- Sağ: Tablo -->
        <div class="col-md-6">
            <h2>Existing Classes</h2>
            @if (lab5.Pages.IndexModel.Classes.Any())
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Class Name</th>
                            <th>Student Count</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var classInfo in lab5.Pages.IndexModel.Classes)
                        {
                            <tr>
                                <td>@classInfo.Id</td>
                                <td>@classInfo.ClassName</td>
                                <td>@classInfo.StudentCount</td>
                                <td>@classInfo.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No classes have been added yet.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Validation Scripts -->
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}