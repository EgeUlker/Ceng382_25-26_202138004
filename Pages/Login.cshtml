@page
@model lab8.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<!-- Sayfanın merkezlenmesi için Bootstrap kullanıyoruz -->
<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card p-4 shadow-lg" style="width: 350px;">
        <h2 class="text-center">Login</h2>

        <form method="post">
            <div class="mb-3">
                <label asp-for="LoginData.Username" class="form-label">Username</label>
                <input asp-for="LoginData.Username" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="LoginData.Password" class="form-label">Password</label>
                <input asp-for="LoginData.Password" type="password" class="form-control" />
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary w-100">Login</button>
            </div>

            <div class="text-danger text-center mt-3">
                @Model.ErrorMessage
            </div>
        </form>
    </div>
</div>